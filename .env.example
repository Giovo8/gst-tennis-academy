# Copia in .env.local e compila. Elenca solo le variabili lette dal codice.

# --- Supabase (obbligatorie) -------------------------------------------------
# Preferibilmente un progetto di sviluppo, non quello di produzione.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo server: bypassa la RLS. Mai con prefisso NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Facoltativa: URL Supabase lato server (default: NEXT_PUBLIC_SUPABASE_URL)
# SUPABASE_URL=

# --- URL dell'app (obbligatorie) ---------------------------------------------
# NEXT_PUBLIC_SITE_URL è anche la whitelist CSRF del middleware.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Email (facoltative: senza, gli invii vengono saltati) -------------------
# RESEND_API_KEY=
# EMAIL_FROM="GST Tennis Academy <noreply@example.com>"

# --- Notizie AI (facoltative: senza, solo parsing RSS) -----------------------
# Usate dalla route /api/ai-news/cleanup. La Edge Function genera-news legge le
# stesse chiavi dai secrets Supabase (supabase secrets set GEMINI_API_KEY=...).
# GEMINI_API_KEY=
# GEMINI_MODEL=

# --- Varie (facoltative) -----------------------------------------------------
# ENABLE_RATE_LIMITING=true
# LOG_LEVEL=info
